filters:
  and:
    - '!file.folder.startsWith("z-templates")'
    - file.ext == "md"
views:
  - type: table
    name: Missing metadata
    filters:
      and:
        - or:
            - description.isEmpty()
            - created.isEmpty()
            - file.tags.isEmpty()
            - note["obsidian-note-status"].isEmpty()
    groupBy:
      property: obsidian-note-status
      direction: ASC
    order:
      - file.name
      - title
      - date
      - description
      - file.tags
      - created
      - obsidian-note-status
    summaries:
      file.name: Filled
    indentProperties: true
  - type: list
    name: Status Unknown
    filters:
      and:
        - note["obsidian-note-status"].isEmpty()
    order:
      - file.name
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
  - type: list
    name: Seeds
    filters:
      and:
        - note["obsidian-note-status"].contains("digital-garden-workflow:seed")
    order:
      - file.name
      - title
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
  - type: list
    name: Sprouts
    filters:
      and:
        - note["obsidian-note-status"].contains("digital-garden-workflow:sprout")
    order:
      - file.name
      - title
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
  - type: list
    name: Saplings
    filters:
      and:
        - note["obsidian-note-status"].contains("digital-garden-workflow:sapling")
    order:
      - file.name
      - title
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
  - type: list
    name: Maps
    filters:
      and:
        - note["obsidian-note-status"].contains("digital-garden-workflow:map")
    order:
      - file.name
      - title
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
