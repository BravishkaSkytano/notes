---
layout: base
eleventyComputed:
  title: "{{ tag | split: '/' | join: ' > ' }}"
  description: All the entries that are tagged with “{{ tag }}”.
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
permalink: /{{ tag }}/
---
<div class="mx-auto max-w-screen-2xl p-6">
  <div class="columns-3xs gap-4">
    {% render 'posts-list', collection: collections[tag] %}
  </div>
</div>
