views:
  - type: table
    name: Drafts
    filters:
      or:
        - draft == true
        - file.folder.startsWith("_")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - tags
      - description
    markers: none
    indentProperties: true
  - type: table
    name: Fleeting Notes
    filters:
      or:
        - file.folder == "1 Fleeting"
        - needsUpdate == true
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - title
      - tags
      - description
    sort: []
    indentProperties: true
    markers: none
  - type: table
    name: Missing metadata
    filters:
      and:
        - file.ext == "md"
        - or:
            - description.isEmpty()
            - date.isEmpty()
            - created.isEmpty()
            - file.tags.isEmpty()
        - draft != true
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - date
      - description
      - file.tags
      - created
    indentProperties: true
