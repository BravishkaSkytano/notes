filters:
  and:
    - file.folder != "Templates"
    - file.tags.contains("type/book")
views:
  - type: cards
    name: All
    order:
      - title
      - subtitle
      - author
      - description
      - category
      - status
    image: note.cover_url
    imageFit: contain
  - type: cards
    name: Reading
    filters:
      and:
        - status == "reading"
    order:
      - title
      - subtitle
      - author
      - description
      - category
      - status
    image: note.cover_url
    imageFit: contain
  - type: cards
    name: DNF
    filters:
      and:
        - status == "dnf"
    order:
      - title
      - subtitle
      - author
      - description
      - category
      - status
    image: note.cover_url
    imageFit: contain
  - type: cards
    name: Finished
    filters:
      and:
        - status == "finished"
    order:
      - title
      - subtitle
      - author
      - description
      - category
      - status
    image: note.cover_url
    imageFit: contain
  - type: cards
    name: TBR
    filters:
      and:
        - status == "tbr"
    order:
      - title
      - subtitle
      - author
      - description
      - category
      - status
    image: note.cover_url
    imageFit: contain
