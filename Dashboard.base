views:
  - type: list
    name: Drafts
    filters:
      or:
        - draft == true
        - file.folder.startsWith("_")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - tags
      - description
    markers: none
    indentProperties: true
  - type: list
    name: Inbox
    filters:
      or:
        - file.folder == "Inbox"
        - needsUpdate == true
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - title
      - tags
      - description
    sort: []
    indentProperties: true
    markers: none
  - type: list
    name: Finished
    filters:
      and:
        - draft != true
        - needsUpdate != true
        - '!file.folder.startsWith("img")'
        - file.ext == "md"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.tags
      - description
    indentProperties: true
    markers: bullet
  - type: cards
    name: Banners
    filters:
      and:
        - "!banner.isEmpty()"
    order:
      - title
      - description
    sort:
      - property: file.path
        direction: ASC
    image: note.banner
    imageAspectRatio: 0.7
    cardSize: 300
  - type: cards
    name: Covers
    filters:
      and:
        - "!cover.isEmpty()"
    order:
      - title
      - description
    sort:
      - property: file.name
        direction: ASC
    image: note.cover
    imageAspectRatio: 1
    cardSize: 260
  - type: list
    name: No banner
    filters:
      and:
        - banner.isEmpty()
        - file.ext == "md"
        - '!file.path.startsWith("_journal")'
  - type: cards
    name: Images
    filters:
      and:
        - file.ext == "webp"
    groupBy:
      property: file.folder
      direction: ASC
    order: []
    sort:
      - property: file.ext
        direction: ASC
    image: file.file
  - type: list
    name: Lacks description
    filters:
      and:
        - description.isEmpty()
        - file.ext == "md"
  - type: list
    name: Indexes
    filters:
      and:
        - index == true
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.tags
      - permalink
    indentProperties: true
