filters:
  and:
    - '!file.folder.startsWith("z-templates")'
    - file.ext == "md"
    - file.name != "index"
views:
  - type: table
    name: Missing metadata
    filters:
      and:
        - file.ext == "md"
        - or:
            - description.isEmpty()
            - created.isEmpty()
            - file.tags.isEmpty()
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - title
      - date
      - description
      - file.tags
      - created
    summaries:
      file.name: Empty
    indentProperties: true
  - type: list
    name: Seeds
    filters:
      and:
        - file.tags.contains("seed")
    order:
      - file.name
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
  - type: list
    name: Sprouts
    filters:
      and:
        - file.tags.contains("sprout")
    order:
      - file.name
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
  - type: list
    name: Saplings
    filters:
      and:
        - file.tags.contains("sapling")
    order:
      - file.name
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
  - type: list
    name: Trees
    filters:
      and:
        - file.tags.contains("tree")
    order:
      - file.name
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
  - type: list
    name: Forest
    filters:
      and:
        - file.tags.contains("forest")
    order:
      - file.name
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
  - type: list
    name: Compost
    filters:
      and:
        - file.tags.contains("compost")
    order:
      - file.name
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
  - type: list
    name: Flowers
    filters:
      and:
        - file.tags.contains("flower")
    order:
      - file.name
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
  - type: list
    name: Status Unknown
    filters:
      and:
        - '!file.tags.containsAny("seed", "sprout", "sappling", "tree", "forest", "compost", "fruit", "flower")'
        - file.ext == "md"
    order:
      - file.name
      - tags
      - description
    sort: []
    indentProperties: true
    markers: bullet
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
