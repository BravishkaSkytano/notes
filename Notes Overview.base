views:
  - type: list
    name: Drafts
    filters:
      and:
        - draft == true
  - type: cards
    name: Banners
    filters:
      and:
        - "!banner.isEmpty()"
    order:
      - title
      - description
    image: note.banner
  - type: list
    name: No banner
    filters:
      and:
        - banner.isEmpty()
        - file.ext == "md"
