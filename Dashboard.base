views:
  - type: list
    name: Drafts
    filters:
      or:
        - draft == true
        - file.folder.startsWith("_")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - tags
      - description
    markers: none
    indentProperties: true
  - type: list
    name: Inbox
    filters:
      or:
        - file.folder == "Inbox"
        - needsUpdate == true
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - title
      - tags
      - description
    sort: []
    indentProperties: true
    markers: none
  - type: cards
    name: Banners
    filters:
      and:
        - "!banner.isEmpty()"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - title
      - description
    sort: []
    image: note.banner
    imageAspectRatio: 0.7
    cardSize: 300
  - type: cards
    name: Covers
    filters:
      and:
        - "!cover.isEmpty()"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - title
      - description
    sort: []
    image: note.cover
    imageAspectRatio: 1
    cardSize: 260
  - type: list
    name: No banner
    filters:
      and:
        - file.ext == "md"
        - or:
            - banner.isEmpty()
            - cover.isEmpty()
        - draft != true
    groupBy:
      property: file.folder
      direction: ASC
  - type: cards
    name: Images
    filters:
      and:
        - file.ext == "webp"
    groupBy:
      property: file.folder
      direction: ASC
    order: []
    sort:
      - property: file.ext
        direction: ASC
    image: file.file
  - type: list
    name: Missing metadata
    filters:
      and:
        - file.ext == "md"
        - or:
            - description.isEmpty()
            - date.isEmpty()
            - created.isEmpty()
            - file.tags.isEmpty()
        - draft != true
        - index != true
        - '!file.folder.startsWith("_")'
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - date
      - description
      - file.tags
    indentProperties: true
  - type: list
    name: Indexes
    filters:
      or:
        - index == true
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.tags
      - permalink
    indentProperties: true
