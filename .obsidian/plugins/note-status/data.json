  "customStatuses": [],
  "showStatusIconsInExplorer": true,
  "hideUnknownStatusInExplorer": true,
  "fileExplorerColorFileName": true,
  "fileExplorerColorBlock": false,
  "fileExplorerLeftBorder": true,
  "fileExplorerStatusDot": false,
  "fileExplorerUnderlineFileName": false,
  "enableExperimentalFeatures": true,
  "enableStatusDashboard": true,
  "enableGroupedStatusView": true,
  "enabledTemplates": [
    "academic",
    "creative-writing",
    "digital-garden-workflow"
  ],
  "useCustomStatusesOnly": false,
  "useMultipleStatuses": true,
  "singleStatusStorageMode": "list",
  "statusBarShowTemplateName": "auto",
  "tagPrefix": "obsidian-note-status",
  "strictStatuses": true,
  "quickStatusCommands": [
    "active",
    "completed",
    "digital-garden-workflow:seed",
    "creative-writing:idea",
    "academic:research"
  ],
  "unknownStatusIcon": "❓",
  "unknownStatusLucideIcon": "question-mark-glyph",
