filters:
  and:
    - file.name != "index"
views:
  - type: table
    name: Drafts
    filters:
      or:
        - draft == true
        - file.folder.startsWith("_")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - tags
      - description
    markers: none
    indentProperties: true
  - type: table
    name: Missing metadata
    filters:
      and:
        - file.ext == "md"
        - or:
            - description.isEmpty()
            - created.isEmpty()
            - file.tags.isEmpty()
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - title
      - date
      - description
      - file.tags
      - created
    summaries:
      file.name: Empty
    indentProperties: true
  - type: table
    name: Fleeting
    filters:
      or:
        - file.folder == "1 Fleeting"
        - needsUpdate == true
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - title
      - tags
      - description
    sort: []
    indentProperties: true
    markers: none
    columnSize:
      file.name: 132
      note.title: 215
      note.tags: 208
  - type: table
    name: Sources
    filters:
      or:
        - file.folder.startsWith("2 Source")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - author
      - status
    sort: []
    indentProperties: true
    markers: none
    image: note.cover
  - type: table
    name: Permanent
    filters:
      or:
        - file.folder == "3 Permanent"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - title
      - tags
      - description
    sort: []
    indentProperties: true
    markers: none
  - type: table
    name: Project
    filters:
      or:
        - file.folder == "4 Project"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - title
      - tags
      - description
    sort: []
    indentProperties: true
    markers: none
  - type: table
    name: Structure
    filters:
      and:
        - file.folder == "5 Structure"
        - file.ext != "base"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - title
      - tags
      - description
    sort: []
    indentProperties: true
    markers: none
