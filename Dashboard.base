views:
  - type: list
    name: Drafts
    filters:
      or:
        - draft == true
        - file.folder.startsWith("_")
    order:
      - file.name
      - title
      - tags
  - type: list
    name: Inbox
    filters:
      or:
        - file.folder == "Inbox"
        - needsUpdate == true
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - title
      - tags
      - description
    sort: []
    indentProperties: false
  - type: list
    name: Finished
    filters:
      and:
        - completed == true
    order:
      - file.name
      - title
      - date
      - description
      - file.tags
  - type: cards
    name: Banners
    filters:
      and:
        - "!banner.isEmpty()"
    order:
      - title
      - description
    sort:
      - property: file.path
        direction: ASC
    image: note.banner
    imageAspectRatio: 0.7
    cardSize: 300
  - type: cards
    name: Covers
    filters:
      and:
        - "!cover.isEmpty()"
    order:
      - title
      - description
    sort:
      - property: file.name
        direction: ASC
    image: note.cover
    imageAspectRatio: 1
    cardSize: 260
  - type: list
    name: No banner
    filters:
      and:
        - banner.isEmpty()
        - file.ext == "md"
        - '!file.path.startsWith("_journal")'
  - type: cards
    name: Images
    filters:
      and:
        - file.ext == "webp"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.size
      - file.ext
    sort:
      - property: file.ext
        direction: ASC
    image: file.file
  - type: list
    name: Lacks description
    filters:
      and:
        - description.isEmpty()
        - file.ext == "md"
