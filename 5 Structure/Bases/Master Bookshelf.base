filters:
  and:
    - file.folder == "2 Source/books"
views:
  - type: cards
    name: All
    groupBy:
      property: status
      direction: ASC
    order:
      - title
      - subtitle
      - author
      - description
      - category
    image: note.cover
    imageAspectRatio: 1.55
  - type: cards
    name: Reading
    filters:
      and:
        - status == "reading"
    order:
      - title
      - subtitle
      - author
      - description
      - category
      - status
    image: note.cover
    imageAspectRatio: 1.55
  - type: cards
    name: DNF
    filters:
      and:
        - status == "dnf"
    order:
      - title
      - subtitle
      - author
      - description
      - category
      - status
    image: note.cover
    imageAspectRatio: 1.55
  - type: cards
    name: Finished
    filters:
      and:
        - status == "finished"
    order:
      - title
      - subtitle
      - author
      - description
      - category
      - status
    image: note.cover
    imageAspectRatio: 1.55
  - type: cards
    name: TBR
    filters:
      and:
        - status == "tbr"
    order:
      - title
      - subtitle
      - author
      - description
      - category
      - status
    image: note.cover
    imageAspectRatio: 1.55
