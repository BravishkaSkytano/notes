views:
  - type: list
    name: Inbox
    filters:
      or:
        - file.basename.startsWith("inbox.")
        - needsUpdate == true
    order:
      - file.name
      - title
      - tags
    sort: []
    indentProperties: false
  - type: list
    name: Drafts
    filters:
      or:
        - needsUpdate == true
        - file.folder == "_drafts"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - title
      - tags
  - type: cards
    name: Banners
    filters:
      and:
        - "!banner.isEmpty()"
    order:
      - title
      - description
    sort:
      - property: file.path
        direction: ASC
    image: note.banner
  - type: list
    name: No banner
    filters:
      and:
        - banner.isEmpty()
        - file.ext == "md"
        - '!file.path.startsWith("_journal")'
  - type: cards
    name: Images
    filters:
      and:
        - '!file.ext.containsAny("md", "html", "base")'
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.size
      - file.ext
    sort:
      - property: file.ext
        direction: ASC
    image: file.file
  - type: cards
    name: Covers
    filters:
      and:
        - "!cover.isEmpty()"
    order:
      - title
      - description
    sort:
      - property: file.name
        direction: ASC
    image: note.cover
  - type: list
    name: Lacks title
    filters:
      and:
        - title.isEmpty()
        - file.ext == "md"
  - type: list
    name: Lacks description
    filters:
      and:
        - description.isEmpty()
        - file.ext == "md"
